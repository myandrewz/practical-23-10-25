# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USERNAME=ticketline_user
DB_PASSWORD=change_this_password

# JWT Configuration
JWT_SECRET=change_this_to_a_very_long_random_secret_key_for_production_minimum_256_bits
JWT_EXPIRATION=3600000

# Server Configuration
SERVER_PORT=8080

# Ticket Reservation Configuration
TICKET_RESERVATION_EXPIRATION_MINUTES=15

# Spring Profile (development or production)
SPRING_PROFILE=production
